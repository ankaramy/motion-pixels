{
  "horizon": 100,
  "approx_distance_m": 5.0,
  "obs_len": 10,
  "features": [
    "du",
    "dv",
    "speed",
    "heading_sin",
    "heading_cos",
    "turn_rate",
    "u",
    "v",
    "dist_to_obstacle_norm",
    "dist_to_boundary_norm"
